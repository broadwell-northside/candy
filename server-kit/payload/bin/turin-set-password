#!/bin/bash
# Set the admin account's password ONCE (it is locked after the install). Run by turin-first-login over SSH:
#   sudo turin-set-password
# After this, full sudo asks for that password; this helper refuses to run again (change it later with `passwd`).
set -euo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"
USER_NAME="$(python3 -c 'import json;print(json.load(open("/opt/turin/config/install.json"))["username"])')"
[[ $USER_NAME =~ ^[a-z][a-z0-9-]{0,30}$ ]] || exit 1
STATE="$(passwd -S "$USER_NAME" | awk '{print $2}')"
if [[ $STATE == P ]]; then echo "$USER_NAME already has a password; change it with: passwd"; exit 0; fi
echo "Choose the password for $USER_NAME (full sudo will ask for it). Keep it in 1Password."
passwd "$USER_NAME"
