{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Image model (Flux.1 dev)"},
        "inputs": {"unet_name": "flux1-dev.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "DualCLIPLoader", "_meta": {"title": "Text encoders (T5-XXL + CLIP-L)"},
        "inputs": {"clip_name1": "t5xxl_fp16.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "VAE"}, "inputs": {"vae_name": "ae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "POSITIVE"}, "inputs": {"text": "", "clip": ["2", 0]}},
  "5": {"class_type": "FluxGuidance", "_meta": {"title": "Guidance"}, "inputs": {"conditioning": ["4", 0], "guidance": 3.5}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "NEGATIVE"}, "inputs": {"text": "", "clip": ["2", 0]}},
  "7": {"class_type": "EmptySD3LatentImage", "_meta": {"title": "SIZE"}, "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "8": {"class_type": "KSampler", "_meta": {"title": "SEED"},
        "inputs": {"model": ["1", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
                   "seed": 0, "steps": 20, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "9": {"class_type": "VAEDecode", "_meta": {"title": "Decode"}, "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "SaveImage", "_meta": {"title": "Save"}, "inputs": {"images": ["9", 0], "filename_prefix": "easy-studio/img"}}
}
